ound{background: var(--wp--preset--gradient--pale-ocean) !important;}.has-electric-grass-gradient-background{background: var(--wp--preset--gradient--electric-grass) !important;}.has-midnight-gradient-background{background: var(--wp--preset--gradient--midnight) !important;}.has-small-font-size{font-size: var(--wp--preset--font-size--small) !important;}.has-medium-font-size{font-size: var(--wp--preset--font-size--medium) !important;}.has-large-font-size{font-size: var(--wp--preset--font-size--large) !important;}.has-x-large-font-size{font-size: var(--wp--preset--font-size--x-large) !important;}.has-anonymous-pro-font-family{font-family: var(--wp--preset--font-family--anonymous-pro) !important;}.has-system-font-font-family{font-family: var(--wp--preset--font-family--system-font) !important;}.has-schibsted-grotesk-font-family{font-family: var(--wp--preset--font-family--schibsted-grotesk) !important;}.has-space-mono-font-family{font-family: var(--wp--preset--font-family--space-mono) !important;}/* Small devices (portrait tablets and large phones, 600px and down) */
@media only screen and (max-width: 600px) {

.sticknav {
position: static !important;}

body .wp-block-uagb-container.uagb-position__sticky--stuck {
position: static !important;
}

}

/* Tablet Only*/

/* Medium devices (landscape tablets, 700px and up) */
@media only screen and (min-width: 700px) {

.enter a {display: none !important;}
.enter {display: none !important;}
}



/* All */

body:not(.home) {background-image: none;}

a:hover {
    cursor: pointer;
}

h1{font-size: 28px !important;}
h2{font-size: 25px !important;}
.wp-block-post-title, .wp-block-query-title {font-family: "Space Mono", monospace !important;}
h3{font-size: 20px !important;}
h4{font-size: 18px !important;}
h5{font-size: 16px !important;}

.wp-block-uagb-container.uagb-block-33ba4751 {
padding-top: 10px;
padding-bottom: 10px;
padding-left: 10px;
padding-right: 10px;}

.wp-block-uagb-container.uagb-block-33ba4751 {background-color: #ffbf00 !important;
border-top-left-radius: 5px;
  border-top-right-radius: 5px;
  border-bottom-left-radius: 5px;
  border-bottom-right-radius: 5px;}

body .wp-block-uagb-container.uagb-position__sticky--stuck {
position: fixed !important;
margin: 0!important;
}

.dropborder, .uagb-post__image img, .wp-block-post-featured-image  {
box-shadow: 10px 10px black;
border-radius: 5px;
}

.uagb-block-b134df14 .uagb-post__text.uagb-post__title a {
font-family: "Space Mono", monospace !important;}

.uagb-slick-carousel {
padding: 0px !important;
}

button.slick-arrow {
background: white !important;
}

.wp-block-navigation a {
font-family: "Space Mono", monospace !important;
font-size: 16px;
}

.staticnav .wp-block-button {
width: 45%;
}

.wp-block-search__input {
font-family: "Schibsted Grotesk", sans-serif;
text-transform: none !important;
font-size: 14px !important;
}


.entry-content a {
}

.wordmark img {
position: absolute;
bottom: 10px;
right: 10px;
width: 120px;}

.wordmark-page img, .wordmark-page {
display: block;
float: right;
width: 120px;
}

.footer-image {
display: block;
}

.wp-block-search__button {
box-shadow: 8px 8px black;
border-radius: 10px;
background-color: none !important;
}

.is-style-outline:hover, .wp-block-button.is-style-outline:hover, .wp-block-button.is-style-outline > .wp-block-button__link:not(.has-background):hover {
  background-color: transparent !important;
color: black !important;
border-color: black !important;
}
:root :where(.wp-block-button .wp-block-button__link){border-radius: 10px;border-top-width: 0px;border-top-style: none;border-right-width: 0px;border-right-style: none;border-bottom-width: 0px;border-bottom-style: none;border-left-width: 0px;border-left-style: none;color: var(--wp--preset--color--contrast);font-family: var(--wp--preset--font-family--anonymous-pro);font-size: 0.8rem;letter-spacing: 1.5px;text-transform: none;box-shadow: 6px 6px 0px rgba(0, 0, 0, 1);}
:root :where(.wp-block-button .wp-block-button__link a:where(:not(.wp-element-button))){color: var(--wp--preset--color--contrast);}
